  m_ActivationSlot: {fileID: 8926484042661614983}
  m_BlockName: Surface Initial Deflection
  m_HLSLCode: "\nvoid SurfaceInit(inout VFXAttributes attributes, in float3 position,
    in float3 normal,\n    in float3 tangent, in float3 bitangent, in float3 incident,
    in float speed,\n    in float retention, in float reflection, in float friction,
    in float lifetime)\n{\n    float2 random = VFXRAND2;\n    float angle = random.x
    * 6.2831853;\n    float3 radial = tangent * cos(angle) + bitangent * sin(angle);\n   
    float inward = max(0.0, -dot(incident, normal));\n    float3 sliding = incident
    - normal * dot(incident, normal);\n    float3 outgoing = sliding * (1.0 - friction)
    + radial * inward * (1.0 - friction) + normal * inward * reflection;\n    float
    energy = speed * retention * lerp(0.55, 1.0, random.y);\n    attributes.position
    = position + normal * 0.06 + radial * 0.06;\n    attributes.velocity = outgoing
    * (energy / max(1.0, length(outgoing)));\n    attributes.lifetime = lifetime
    * lerp(0.65, 1.0, VFXRAND);\n}\n"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: SurfaceInit
    selectedIndex: 0
