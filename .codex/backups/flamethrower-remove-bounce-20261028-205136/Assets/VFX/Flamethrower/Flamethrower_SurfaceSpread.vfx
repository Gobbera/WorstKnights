  m_ActivationSlot: {fileID: 8926484042661614974}
  m_BlockName: Surface Gradual Dissipation
  m_HLSLCode: "\nvoid SurfaceFade(inout VFXAttributes attributes, in float scale,
    in float fade)\n{\n    float progress = saturate(attributes.age / max(attributes.lifetime,
    0.0001));\n    attributes.alpha *= pow(saturate(1.0 - progress), max(0.1, fade));\n   
    attributes.size *= scale * (1.0 + progress * 0.35);\n}\n"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: SurfaceFade
    selectedIndex: 0
