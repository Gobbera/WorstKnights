  m_Name: 
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Block.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 8926484042661614767}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 8926484042661615133}
  - {fileID: 8926484042661615134}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 8926484042661615132}
  m_BlockName: Surface Gradual Dissipation
  m_HLSLCode: "\nvoid SurfaceFade(inout VFXAttributes attributes, in float scale,
    in float fade)\n{\n    float progress = saturate(attributes.age / max(attributes.lifetime,
    0.0001));\n    attributes.alpha *= pow(saturate(1.0 - progress), max(0.1, fade));\n   
    attributes.size *= scale * (1.0 + progress * 0.35);\n}\n"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: SurfaceFade
    selectedIndex: 0
