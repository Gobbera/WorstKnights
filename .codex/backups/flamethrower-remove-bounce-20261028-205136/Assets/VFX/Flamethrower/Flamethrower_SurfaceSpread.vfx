  m_Name: 
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Block.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 114780028408030698}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 8926484042661614937}
  - {fileID: 8926484042661614941}
  - {fileID: 8926484042661614945}
  - {fileID: 8926484042661614949}
  - {fileID: 8926484042661614953}
  - {fileID: 8926484042661614954}
  - {fileID: 8926484042661614955}
  - {fileID: 8926484042661614956}
  - {fileID: 8926484042661614957}
  - {fileID: 8926484042661614962}
  - {fileID: 8926484042661614967}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 8926484042661614936}
  m_BlockName: Surface Drag And Contact
  m_HLSLCode: "\nvoid SurfaceFlow(inout VFXAttributes attributes, in float3 position,
    in float3 normal,\n    in float3 tangent, in float3 bitangent, in float drag,
    in float buoyancy,\n    in float reflection, in float friction, in float4 limitsA,
    in float4 limitsB, in float dt)\n{\n    attributes.velocity *= exp(-max(0.0,
    drag) * dt);\n    attributes.velocity += float3(0.0, buoyancy, 0.0) * dt;\n   
    float height = dot(attributes.position - position, normal);\n    if (height <
    0.06)\n    {\n        attributes.position += normal * (0.06 - height);\n       
    float vn = dot(attributes.velocity, normal);\n        if (vn < 0.0) attributes.velocity
    -= normal * ((1.0 + reflection) * vn);\n        float3 normalVelocity = normal
    * dot(attributes.velocity, normal);\n        attributes.velocity = normalVelocity
    + (attributes.velocity - normalVelocity) * (1.0 - friction);\n    }\n    float3
    offset = attributes.position - position;\n    float3 radial = offset - normal
    * dot(offset, normal);\n    float radius = length(radial);\n    float sector
    = frac(atan2(dot(radial, bitangent), dot(radial, tangent)) / 6.2831853 + 1.0)
    * 8.0;\n    uint ia = (uint)floor(sector) % 8;\n    uint ib = (ia + 1) % 8;\n   
    float limitA = ia < 4 ? limitsA[ia % 4] : limitsB[ia % 4];\n    float limitB
    = ib < 4 ? limitsA[ib % 4] : limitsB[ib % 4];\n    float limit = max(0.0, min(limitA,
    limitB));\n    if (radius > limit && radius > 0.0001)\n    {\n        attributes.position
    -= radial * (1.0 - limit / radius);\n        attributes.velocity *= 0.15;\n       
    attributes.age += dt * 4.0;\n    }\n}\n"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: SurfaceFlow
    selectedIndex: 0
